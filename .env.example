DATABASE_URL=
PORT=3001
APP_ORIGIN=http://localhost:5173
AUTH_MODE=mock
MOCK_LOGIN_KEY=replace-with-random-test-password
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
BITRIX_PORTAL=
# Optional security pin. Leave blank for the first fully verified wizard install;
# if set, incoming/OAuth member_id must match it exactly.
BITRIX_MEMBER_ID=
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
BITRIX_ADMIN_USER_ID=
# Fail-closed флаг для POST /bitrix/onappinstall (server-to-server ONAPPINSTALL
# webhook, apps/backend/src/bitrix.ts). Не "true" по умолчанию — endpoint
# ничего не пишет и отвечает {result:false}. Включать только после проверки
# на тестовом портале Bitrix24 (REQUIRES BITRIX24 TEST PORTAL VERIFICATION).
BITRIX_INSTALL_WEBHOOK_ENABLED=false
POSTGRES_PASSWORD=replace-with-random-url-safe-password
APP_HOST=construction-test.example.com
BITRIX_FRAME_ORIGIN=https://your-test-portal.bitrix24.ru
BIND_HOST=0.0.0.0
DB_MODE=postgres
NODE_ENV=test

# Frontend service only: server-side reverse proxy destination
BACKEND_UPSTREAM=http://api:3001
# Railway build argument: api for backend, web for frontend
APP_TARGET=web
# Browser acceptance against an external URL
E2E_BASE_URL=

# F6: which DataProvider the internal application (/app.html) uses — 'mock'
# (default, demo fixtures) or 'real' (GET /api/snapshot). Unset means mock;
# a real deployment must set this explicitly. Vite build-time var, must be
# set when running `npm run build` / `vite build`, not read at runtime.
VITE_DATA_PROVIDER=mock
