{
  "name": "construction-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:api": "node --import tsx apps/backend/src/main.ts",
    "dev:web": "vite --config apps/frontend/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/frontend/vite.config.ts",
    "build:core": "tsc --noEmit && vite build --config apps/frontend/vite.config.ts --mode core",
    "typecheck:strict": "tsc --noEmit -p apps/frontend/tsconfig.strict.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:local": "node --import tsx scripts/local-postgres.ts",
    "test:browser": "playwright test",
    "test:ds": "playwright test --config playwright.ds.config.ts",
    "test:f6-browser": "playwright test --config playwright.f6.config.ts",
    "test:f7-browser": "playwright test --config playwright.f7.config.ts",
    "test:f8.1-browser": "playwright test --config playwright.f8.1.config.ts",
    "test:f7-prod": "playwright test --config playwright.f7-prod.config.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.0.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@tanstack/react-query": "^5.0.0",
    "antd": "^5.27.0",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.0.0",
    "react-router-dom": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
